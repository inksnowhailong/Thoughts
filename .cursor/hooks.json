{
    "version": 1,
    "hooks": {
        "sessionStart": [
            {
                "command": "node .cursor/hooks/thoughts-session-start.mjs"
            }
        ],
        "beforeSubmitPrompt": [
            {
                "command": "node .cursor/hooks/thoughts-before-submit.mjs",
                "matcher": "UserPromptSubmit"
            }
        ],
        "stop": [
            {
                "command": "node .cursor/hooks/thoughts-loop-driver.mjs",
                "timeout": 60000,
                "loop_limit": 1000,
                "failClosed": false
            },
            {
                "command": "node .cursor/hooks/team-stop-driver.mjs",
                "timeout": 10,
                "loop_limit": 1,
                "failClosed": false
            }
        ]
    }
}
