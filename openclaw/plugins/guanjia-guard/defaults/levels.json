  "rules": [
    { "tool": "read", "param": "path", "pattern": "(?:^|[\\s\"',(=])(?:\\\\\\\\|//)[^\\\\/\\s]|[\\\\/]\\.openclaw[\\\\/](?!workspace(?:$|[\\s\"'\\\\/](?!guanjia(?:$|[\\s\"'\\\\/]))))|(?:^|[\\s\"'=(,\\\\/])\\.\\.(?:$|[\\s\"'\\\\/])|(?:^|[\\s\"'=(,])(?:\\.[\\\\/])?guanjia[\\\\/]|\\benv:|openclaw-weixin|\\.bak-", "level": "L3", "note": "敏感路径：UNC、.openclaw 下除 workspace 以外或 workspace/guanjia、env:、openclaw-weixin、.bak-" },
    { "tool": "read", "param": "file_path", "pattern": "(?:^|[\\s\"',(=])(?:\\\\\\\\|//)[^\\\\/\\s]|[\\\\/]\\.openclaw[\\\\/](?!workspace(?:$|[\\s\"'\\\\/](?!guanjia(?:$|[\\s\"'\\\\/]))))|(?:^|[\\s\"'=(,\\\\/])\\.\\.(?:$|[\\s\"'\\\\/])|(?:^|[\\s\"'=(,])(?:\\.[\\\\/])?guanjia[\\\\/]|\\benv:|openclaw-weixin|\\.bak-", "level": "L3", "note": "同上（参数名变体）" },
    { "tool": "ls", "param": "path", "pattern": "(?:^|[\\s\"',(=])(?:\\\\\\\\|//)[^\\\\/\\s]|[\\\\/]\\.openclaw[\\\\/](?!workspace(?:$|[\\s\"'\\\\/](?!guanjia(?:$|[\\s\"'\\\\/]))))|(?:^|[\\s\"'=(,\\\\/])\\.\\.(?:$|[\\s\"'\\\\/])|(?:^|[\\s\"'=(,])(?:\\.[\\\\/])?guanjia[\\\\/]|\\benv:|openclaw-weixin|\\.bak-", "level": "L3", "note": "同上" },
    { "tool": "ls", "param": "file_path", "pattern": "(?:^|[\\s\"',(=])(?:\\\\\\\\|//)[^\\\\/\\s]|[\\\\/]\\.openclaw[\\\\/](?!workspace(?:$|[\\s\"'\\\\/](?!guanjia(?:$|[\\s\"'\\\\/]))))|(?:^|[\\s\"'=(,\\\\/])\\.\\.(?:$|[\\s\"'\\\\/])|(?:^|[\\s\"'=(,])(?:\\.[\\\\/])?guanjia[\\\\/]|\\benv:|openclaw-weixin|\\.bak-", "level": "L3", "note": "同上（参数名变体）" },
    { "tool": "exec", "param": "command", "pattern": "(remove-item|\\brm\\b|\\bdel\\b|\\berase\\b|rmdir|\\brd\\b|(?<!-)\\bformat(-volume)?(?=\\s|$)|diskpart|shutdown|restart-computer|stop-computer|\\breg\\s+(add|delete)|set-itemproperty|stop-process|taskkill|net\\s+user|icacls|takeown|bcdedit|cipher\\s+/w|invoke-webrequest|\\biwr\\b|\\bcurl\\b|\\bwget\\b|\\bipconfig\\b.*[/-](release|renew|flushdns|registerdns|setclassid)|(?:^|[\\s\"',(=])(?:\\\\\\\\|//)[^\\\\/\\s]|[\\\\/]\\.openclaw[\\\\/](?!workspace(?:$|[\\s\"'\\\\/](?!guanjia(?:$|[\\s\"'\\\\/]))))|(?:^|[\\s\"'=(,\\\\/])\\.\\.(?:$|[\\s\"'\\\\/])|(?:^|[\\s\"'=(,])(?:\\.[\\\\/])?guanjia[\\\\/]|\\benv:|openclaw-weixin|\\.bak-)", "level": "L3", "note": "删除/关机/改注册表/杀进程/外连下载（format 只认独立命令，不误伤 Format-Table 和 -Format 参数）" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(powershell(\\.exe)?|c:\\\\windows\\\\system32\\\\windowspowershell\\\\v1\\.0\\\\powershell\\.exe) -NoProfile -ExecutionPolicy Bypass -File C:\\\\Users\\\\inksn\\\\\\.openclaw\\\\workspace\\\\tools\\\\launch-app\\.ps1 -Name [A-Za-z0-9_-]+\\s*$", "level": "L1", "note": "S2 启动器（开游戏/开程序），与 exec-approvals 白名单同形" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(?:start|start-process)\\s+(?:\"?(?!(?:logoff|tsdiscon|shutdown|rstrui|systemreset|cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|msiexec|msdt|wsl|bash|ftp|fodhelper|computerdefaults|sdclt|reg|regedit|schtasks|sc|net|wmic|certutil|bitsadmin)(?:\\.exe)?\"?\\s*$)[a-z0-9_.+-]+\"?|\"?(?:https?|steam)://[^\\s;&|`$<>(){}\\[\\]@%\"']*\"?)\\s*$", "level": "L1", "note": "启动程序/游戏/网页：只许裸程序名（notepad）或 协议:// 地址（steam://、https://），不许路径/参数/提权" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(?:(?:cmd(?:\\.exe)?\\s+/c\\s+)?\"?(?:\\.[\\\\/]|c:\\\\users\\\\inksn\\\\\\.openclaw\\\\workspace\\\\)?launch_chrome\\.bat\"?|(?:powershell(?:\\.exe)?\\s+-NoProfile(?:\\s+-ExecutionPolicy\\s+Bypass)?\\s+-File\\s+)?\"?(?:\\.[\\\\/]|c:\\\\users\\\\inksn\\\\\\.openclaw\\\\workspace\\\\)?find_chrome\\.ps1\"?)\\s*$", "level": "L1", "note": "工作区内既有的开浏览器脚本（只认确切调用；脚本本身写入已是 L3）" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(dir|type|get-childitem|get-content|get-process|tasklist|get-date|whoami|hostname|ipconfig|echo)(?=\\s|$)[^;&|`$<>(){}\\[\\]@%\\r\\n]*$", "level": "L0", "note": "只读查询命令（无拼接无重定向；命令名必须完整，不认 Get-Process-Xxx）" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(?:(?:powershell|pwsh)(?:\\.exe)?\\s+(?:(?:-noprofile|-nologo|-noninteractive|-executionpolicy\\s+(?:bypass|remotesigned|unrestricted))\\s+)*-c(?:ommand)?\\s+\"?)?(?:\\(\\s*(?:get-(?:process|service|childitem|item|itemproperty|content|date|ciminstance|wmiobject|computerinfo|volume|psdrive|netipaddress|netadapter|command|scheduledtask|hotfix|location)|test-path|tasklist|dir|ls|type|hostname|whoami|ipconfig|systeminfo|where\\.exe)(?=\\s|\\)|\"\\s*$|$)[^;&|`$<>(){}\\[\\]@%\\r\\n]*\\)(?:\\.[a-z_][a-z0-9_]*)*|(?:get-(?:process|service|childitem|item|itemproperty|content|date|ciminstance|wmiobject|computerinfo|volume|psdrive|netipaddress|netadapter|command|scheduledtask|hotfix|location)|test-path|tasklist|dir|ls|type|hostname|whoami|ipconfig|systeminfo|where\\.exe)(?=\\s|\\)|\"\\s*$|$)[^;&|`$<>(){}\\[\\]@%\\r\\n]*)(?:\\s*\\|\\s*(?:select-object|select|where-object|where|sort-object|sort|format-table|ft|format-list|fl|measure-object|measure|group-object|select-string|out-string|convertto-json|findstr)(?=\\s|\"\\s*$|$)[^;&|`$<>(){}\\[\\]@%\\r\\n]*)*\"?\\s*$", "level": "L0", "note": "只读 PowerShell 管道：白名单 Get 类命令接白名单筛选/排序/格式化命令；不许 ; & ` $ < > ( ) { } [ ] @ % 和换行（括号只许整段包住单条只读命令后取属性）" },
    { "tool": "process", "param": "action", "pattern": "^(list|poll|log)$", "level": "L0", "note": "只看后台进程列表和输出，不改变进程" },
    { "tool": "write", "param": "path", "pattern": "(?:^|[\\\\/])tools[.\\s]*[\\\\/]|(?:^|[\\\\/])apps\\.json(?=[.\\s]*$|[\\s\"':])|\\.(?:bat|cmd|ps1|psm1|psd1|ps1xml|vbs|vbe|js|jse|wsf|wsh|exe|com|scr|msi|lnk|reg|hta|cpl|msc|pif|dll)(?=[.\\s]*$|[\\s\"':])", "level": "L3", "note": "写 tools 目录 / apps.json / 可执行或脚本文件（含启动器映射）要带外审批" },
    { "tool": "write", "param": "file_path", "pattern": "(?:^|[\\\\/])tools[.\\s]*[\\\\/]|(?:^|[\\\\/])apps\\.json(?=[.\\s]*$|[\\s\"':])|\\.(?:bat|cmd|ps1|psm1|psd1|ps1xml|vbs|vbe|js|jse|wsf|wsh|exe|com|scr|msi|lnk|reg|hta|cpl|msc|pif|dll)(?=[.\\s]*$|[\\s\"':])", "level": "L3", "note": "同上（参数名变体）" },
    { "tool": "edit", "param": "path", "pattern": "(?:^|[\\\\/])tools[.\\s]*[\\\\/]|(?:^|[\\\\/])apps\\.json(?=[.\\s]*$|[\\s\"':])|\\.(?:bat|cmd|ps1|psm1|psd1|ps1xml|vbs|vbe|js|jse|wsf|wsh|exe|com|scr|msi|lnk|reg|hta|cpl|msc|pif|dll)(?=[.\\s]*$|[\\s\"':])", "level": "L3", "note": "同上（edit）" },
    { "tool": "edit", "param": "file_path", "pattern": "(?:^|[\\\\/])tools[.\\s]*[\\\\/]|(?:^|[\\\\/])apps\\.json(?=[.\\s]*$|[\\s\"':])|\\.(?:bat|cmd|ps1|psm1|psd1|ps1xml|vbs|vbe|js|jse|wsf|wsh|exe|com|scr|msi|lnk|reg|hta|cpl|msc|pif|dll)(?=[.\\s]*$|[\\s\"':])", "level": "L3", "note": "同上（edit 参数名变体）" },
    { "tool": "apply_patch", "param": "$anyDerivedPaths", "pattern": "(?:^|[\\\\/])tools[.\\s]*[\\\\/]|(?:^|[\\\\/])apps\\.json(?=[.\\s]*$|[\\s\"':])|\\.(?:bat|cmd|ps1|psm1|psd1|ps1xml|vbs|vbe|js|jse|wsf|wsh|exe|com|scr|msi|lnk|reg|hta|cpl|msc|pif|dll)(?=[.\\s]*$|[\\s\"':])", "level": "L3", "note": "补丁落到 tools / apps.json / 可执行脚本文件要带外审批" },
    { "tool": "write", "param": "path", "pattern": "^(\\.[\\\\/])?guanjia[\\\\/]|[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/]", "level": "L3", "note": "工作区 guanjia/ 下的分级表/家庭事实/审计属于安全配置，模型改它要带外审批" },
    { "tool": "write", "param": "file_path", "pattern": "^(\\.[\\\\/])?guanjia[\\\\/]|[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/]", "level": "L3", "note": "同上（参数名变体）" },
    { "tool": "edit", "param": "path", "pattern": "^(\\.[\\\\/])?guanjia[\\\\/]|[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/]", "level": "L3", "note": "同上" },
    { "tool": "edit", "param": "file_path", "pattern": "^(\\.[\\\\/])?guanjia[\\\\/]|[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/]", "level": "L3", "note": "同上" },
    { "tool": "apply_patch", "param": "$derivedPaths", "pattern": "^(?!(\\.[\\\\/])?guanjia[\\\\/])(?!.*[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/])(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "补丁只动工作区内文件" },
