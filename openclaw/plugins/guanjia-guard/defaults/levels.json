    { "tool": "write", "param": "file_path", "pattern": "^(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "同上（参数名变体）" },
    { "tool": "edit", "param": "path", "pattern": "^(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "改工作区内文件" },
    { "tool": "edit", "param": "file_path", "pattern": "^(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "同上（参数名变体）" }
