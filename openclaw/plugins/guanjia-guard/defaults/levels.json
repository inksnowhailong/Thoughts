    "cron": "L1",
    "automations": "L1",
    "image_generate": "L1",
    "write": "L2",
    "edit": "L2",
    "apply_patch": "L2",
    "exec": "L3",
    "process": "L2",
    "message": "L2",
    "sessions_send": "L2",
