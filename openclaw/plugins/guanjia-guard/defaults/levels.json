{
  "_说明": "管家行为分级表。判定顺序：overrides（未过期的临时提权/降权）→ rules（按顺序首个命中）→ tools（按工具名）→ defaultLevel。L0 只读直接过；L1 可逆白名单直接过；L2 需回话确认；L3 需手机/桌面带外审批。cron/心跳触发的会话自动降一档（L1→L2，L2→L3）。rules 的 param 为参数名，$derivedPaths 表示宿主推导的目标路径（全部命中才算）；pattern 为正则（不区分大小写）。overrides 每条必须带 expiresAt（ISO 时间），scope 为 global 或 session:<sessionKey>。",
  "defaultLevel": "L2",
  "proactiveDowngrade": true,
  "tools": {
    "read": "L0",
    "memory_search": "L0",
    "memory_get": "L0",
    "web_search": "L0",
    "web_fetch": "L0",
    "x_search": "L0",
    "view_image": "L0",
    "session_status": "L0",
    "sessions_list": "L0",
    "sessions_history": "L0",
    "agents_list": "L0",
    "get_goal": "L0",
    "tool_search": "L0",
    "tool_describe": "L0",
    "ask_user": "L0",
    "progress_card": "L1",
    "tts": "L1",
    "browser": "L1",
    "cron": "L1",
    "automations": "L1",
    "image_generate": "L1",
    "write": "L2",
    "edit": "L2",
    "apply_patch": "L2",
    "exec": "L3",
    "process": "L2",
    "message": "L2",
    "sessions_send": "L2",
    "subagents": "L2",
    "code_execution": "L2",
    "gateway": "L3",
    "plugins": "L3",
    "nodes": "L3",
    "secrets": "L3",
    "terminal": "L3"
  },
  "rules": [
    { "tool": "exec", "param": "command", "pattern": "(remove-item|\\brm\\b|\\bdel\\b|\\berase\\b|rmdir|\\brd\\b|format(-volume)?\\b|diskpart|shutdown|restart-computer|stop-computer|\\breg\\s+(add|delete)|set-itemproperty|stop-process|taskkill|net\\s+user|icacls|takeown|bcdedit|cipher\\s+/w|invoke-webrequest|\\biwr\\b|\\bcurl\\b|\\bwget\\b)", "level": "L3", "note": "删除/关机/改注册表/杀进程/外连下载" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(powershell(\\.exe)?|c:\\\\windows\\\\system32\\\\windowspowershell\\\\v1\\.0\\\\powershell\\.exe) -NoProfile -ExecutionPolicy Bypass -File C:\\\\Users\\\\inksn\\\\\\.openclaw\\\\workspace\\\\tools\\\\launch-app\\.ps1 -Name [A-Za-z0-9_-]+\\s*$", "level": "L1", "note": "S2 启动器（开游戏/开程序），与 exec-approvals 白名单同形" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(start|start-process)\\s+[^;&|`$<>\\r\\n]*$", "level": "L1", "note": "启动程序/游戏/网页（无命令拼接）" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(cmd(\\.exe)?\\s+/c\\s+)?\"?[^;&|`$<>\\r\\n]*(launch_chrome\\.bat|find_chrome\\.ps1)\"?[^;&|`$<>\\r\\n]*$", "level": "L1", "note": "工作区内既有的开浏览器脚本" },
    { "tool": "exec", "param": "command", "pattern": "^\\s*(dir|type|get-childitem|get-content|get-process|tasklist|get-date|whoami|hostname|ipconfig|echo)\\b[^;&|`$<>\\r\\n]*$", "level": "L0", "note": "只读查询命令（无拼接无重定向）" },
    { "tool": "write", "param": "path", "pattern": "^(\\.[\\\\/])?guanjia[\\\\/]|[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/]", "level": "L3", "note": "工作区 guanjia/ 下的分级表/家庭事实/审计属于安全配置，模型改它要带外审批" },
    { "tool": "write", "param": "file_path", "pattern": "^(\\.[\\\\/])?guanjia[\\\\/]|[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/]", "level": "L3", "note": "同上（参数名变体）" },
    { "tool": "edit", "param": "path", "pattern": "^(\\.[\\\\/])?guanjia[\\\\/]|[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/]", "level": "L3", "note": "同上" },
    { "tool": "edit", "param": "file_path", "pattern": "^(\\.[\\\\/])?guanjia[\\\\/]|[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/]", "level": "L3", "note": "同上" },
    { "tool": "apply_patch", "param": "$derivedPaths", "pattern": "^(?!(\\.[\\\\/])?guanjia[\\\\/])(?!.*[\\\\/]\\.openclaw[\\\\/]workspace[\\\\/]guanjia[\\\\/])(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "补丁只动工作区内文件" },
    { "tool": "write", "param": "path", "pattern": "^(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "写工作区内文件（含 S2 的 memory/ 时间线）" },
    { "tool": "write", "param": "file_path", "pattern": "^(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "同上（参数名变体）" },
    { "tool": "edit", "param": "path", "pattern": "^(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "改工作区内文件" },
    { "tool": "edit", "param": "file_path", "pattern": "^(?!.*\\.\\.)((?![a-z]:|[\\\\/~]).+|c:[\\\\/]users[\\\\/]inksn[\\\\/]\\.openclaw[\\\\/]workspace([\\\\/].*)?)$", "level": "L1", "note": "同上（参数名变体）" }
  ],
  "overrides": []
}
