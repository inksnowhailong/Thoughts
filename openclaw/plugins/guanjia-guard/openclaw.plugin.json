{
  "id": "guanjia-guard",
  "name": "Guanjia Guard",
  "description": "L0-L3 tool gating, cloud redaction proxy, habit confirmation flow.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "speak",
      "launch_app",
      "get_location",
      "get_desktop_status",
      "environment_snapshot",
      "get_weather",
      "camera_photo",
      "camera_ptz",
      "camera_look",
      "task_start",
      "task_status",
      "task_cancel",
      "task_report"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaceDir": {
        "type": "string"
      },
      "proxy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "port": {
            "type": "number"
          },
          "upstreamOrigin": {
            "type": "string"
          }
        }
      },
      "habitTz": {
        "type": "string"
      },
      "speakUrl": {
        "type": "string"
      }
    }
  }
}