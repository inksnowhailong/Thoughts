{
  "description": "思绪模式 Hook — 人格/画像/记忆注入 + 回合后通知冲洗",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/runtime/hooks/inject.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/runtime/hooks/flush-notify.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
